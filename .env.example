# Copy this file to .env (same folder) and fill in your keys. Never commit .env.
# Alpaca (free paper account at alpaca.markets): real-time news stream
ALPACA_KEY_ID=
ALPACA_SECRET=
# Finnhub (free at finnhub.io): market news, checked every 30 seconds. Use the API key, not the webhook secret.
FINNHUB_KEY=
# X developer app (reading posts needs the Basic tier or higher)
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
# Phone alerts: install the ntfy app, subscribe to a secret topic name, put it here
NTFY_TOPIC=
# Seconds between X checks (lower uses your X API quota faster)
X_POLL_SECONDS=60
