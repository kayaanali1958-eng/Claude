# Copy this file to .env (same folder) and fill in your keys. Never commit .env.
# Alpaca (free paper account at alpaca.markets): real-time news stream
ALPACA_KEY_ID=
ALPACA_SECRET=
# Finnhub (free at finnhub.io): market news, checked every 30 seconds. Use the API key, not the webhook secret.
FINNHUB_KEY=
# X developer app (reading posts needs the Basic tier or higher)
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
# Phone alerts: install the ntfy app, subscribe to a secret topic name, put it here
NTFY_TOPIC=
# Crypto live mode: the most money the crypto desk may use, in dollars, or "all" for the whole account cash (only matters when CRYPTO_MODE: live)
CRYPTO_LIVE_MAX=
# Crypto live position size: empty = 1% risk per trade; 2% = 2% risk; all = every trade uses all the book's cash (one trade at a time)
CRYPTO_SIZE=
# Crypto live safety lock: empty = trade only when the daily replay of recent months made money;
# off = trade anyway (the replay shows the expected losses: see backtests/crypto_report_*.md)
CRYPTO_GATE=
# Long-term funds + AI portfolio (phase 2, paper until then): starting paper money (default 1000)
AI_PORTFOLIO_START=
# Seconds between X checks (lower uses your X API quota faster)
X_POLL_SECONDS=60
